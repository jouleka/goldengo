    "Use what is available now, before upcoming bills and money already reserved for goals." : { "localizations" : { "sq" : { "stringUnit" : { "state" : "translated", "value" : "Përdor shumën e disponueshme tani, para faturave të ardhshme dhe parave të rezervuara për objektivat." } } } },
    "Your daily allowance includes today and the final day." : { "localizations" : { "sq" : { "stringUnit" : { "state" : "translated", "value" : "Kufiri yt ditor përfshin sot dhe ditën e fundit." } } } },
