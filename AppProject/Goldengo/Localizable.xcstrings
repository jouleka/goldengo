    "Explore first" : { "localizations" : { "sq" : { "stringUnit" : { "state" : "translated", "value" : "Eksploro fillimisht" } } } },
    "Give your daily allowance a real amount and end date" : { "localizations" : { "sq" : { "stringUnit" : { "state" : "translated", "value" : "Jepi kufirit ditor një shumë dhe datë përfundimi reale" } } } },
    "Go to Home" : { "localizations" : { "sq" : { "stringUnit" : { "state" : "translated", "value" : "Shko te Kryefaqja" } } } },
    "Goldengo will ask you to start the next period." : { "localizations" : { "sq" : { "stringUnit" : { "state" : "translated", "value" : "Goldengo do të të kërkojë të fillosh periudhën tjetër." } } } },
    "Goldengo will use the current Wallet and named-source balances. Reconcile them whenever reality changes." : { "localizations" : { "sq" : { "stringUnit" : { "state" : "translated", "value" : "Goldengo do të përdorë gjendjen aktuale të Portofolit dhe burimeve të emërtuara. Përditësoji sa herë ndryshon gjendja reale." } } } },
